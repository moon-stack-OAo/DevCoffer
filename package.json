{
  "name": "devcoffer",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/gen-sitemap.mjs && node scripts/gen-icons-css.mjs",
    "predev": "node scripts/gen-icons-css.mjs",
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "icons": "node scripts/gen-icons-css.mjs",
    "parity": "node scripts/parity.mjs",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap-icons": "^1.13.1",
    "hls.js": "^1.7.1",
    "isomorphic-dompurify": "^3.19.0",
    "js-beautify": "^2.0.3",
    "js-yaml": "^5.3.0",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.10",
    "mermaid": "^11.16.1",
    "mqtt": "^5.15.2",
    "nuxt": "3.15.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.8.2",
    "ua-parser-js": "^2.0.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/js-beautify": "^1.14.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsbarcode": "^3.11.4",
    "@types/leaflet": "^1.9.22",
    "@types/mqtt": "^0.0.34",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3",
    "vue-tsc": "^2.2.8"
  }
}
